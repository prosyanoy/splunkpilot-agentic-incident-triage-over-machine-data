# Copy to .env (never commit .env). Every value has a safe local default.

# Location of the SQLite event store used by `splunkpilot serve`.
SPLUNKPILOT_DB=data/splunkpilot.db
# Token expected by the HEC endpoint (Authorization: Splunk <token>). Demo value only.
SPLUNKPILOT_HEC_TOKEN=dev-hec-token
# Base URL the CLI uses to reach the API.
SPLUNKPILOT_URL=http://localhost:8000

# LLM backend: "mock" (deterministic, offline) or "ollama".
SPLUNKPILOT_LLM=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
